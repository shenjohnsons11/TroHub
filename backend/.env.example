# Cổng chạy Backend
PORT=5000
NODE_ENV=development

# Cấu hình MongoDB
# 1. Nếu dùng MongoDB Atlas (Khuyên dùng khi deploy / public):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trohub?retryWrites=true&w=majority

# 2. Hoặc nếu dùng MongoDB Local trên máy tính:
# MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/trohub

# Khóa bí mật JWT (Bắt buộc)
JWT_SECRET=trohub_secret_key_change_me_in_production_2026

# Danh sách Origin được phép gọi API (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Khóa bảo vệ nạp dữ liệu mẫu /api/seed
SEED_SECRET=trohub_seed_secret_dev

